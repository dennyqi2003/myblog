{
  "name": "myblog",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Static blog built from the notes/ folder of markdown files",
  "scripts": {
    "content": "node scripts/build-content.mjs",
    "dev": "node scripts/build-content.mjs && vite",
    "build": "node scripts/build-content.mjs && vite build && node scripts/prerender.mjs",
    "preview": "vite preview --port 4173",
    "clean": "node scripts/clean.mjs"
  },
  "dependencies": {
    "mermaid": "^11.4.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.21",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "vite": "^6.3.5"
  },
  "engines": {
    "node": ">=20"
  }
}
